[Unit]
Description=System Monitoring Dashboard (CPU/RAM/GPU/Disk/VMs)
After=network.target libvirtd.service qemu-system.service
Wants=network.target libvirtd.service

[Service]
Type=simple
User=keshav
Group=keshav
WorkingDirectory=/home/keshav/monitoring-dashboard/backend
ExecStart=/home/keshav/monitoring-dashboard/.venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment="HOME=/home/keshav"
Environment="PATH=/home/keshav/monitoring-dashboard/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=multi-user.target