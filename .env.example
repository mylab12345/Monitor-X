# Local-first default. Use 0.0.0.0 only behind a trusted HTTPS reverse proxy.
MONITORX_HOST=127.0.0.1
MONITORX_PORT=8080

# Leave empty for localhost-only use. Set a long random value for network access.
MONITORX_AUTH_TOKEN=
# Set true only when MonitorX is served over HTTPS (directly or by a trusted proxy).
MONITORX_COOKIE_SECURE=false
# Optional explicit outbound target for the health probe; empty means no beacon.
MONITORX_CONNECTIVITY_TARGET=

# Telemetry tuning
MONITORX_STATS_INTERVAL=2
MONITORX_PROCESS_TTL=5
MONITORX_CONNECTIONS_TTL=10
MONITORX_LIBVIRT_URI=qemu:///system

# VM Guest Insights (SSH-based processes/users/root-disk inspection)
MONITORX_INSIGHTS_SSH_TIMEOUT=12
MONITORX_INSIGHTS_TTL=5
MONITORX_INSIGHTS_OVERVIEW_TTL=10
MONITORX_INSIGHTS_CONCURRENCY=6
